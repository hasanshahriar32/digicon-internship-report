\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{internship}[2026/10/04 HSTU Internship Report Professional Styling Package]

% Page geometry: 1.25 inch left for binding margin, 1.0 inch top/bottom/right
\RequirePackage[a4paper,top=1in,bottom=1in,left=1.25in,right=1in]{geometry}

% Mathematics
\RequirePackage{amsmath,amssymb,amsfonts,amsthm}
\RequirePackage{mathtools}
\RequirePackage{bm}

% Typography & Spacing (Times New Roman, 12pt)
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{setspace}
\onehalfspacing % Standard 1.5 line spacing for academic reports

% Prevent text overflow into margins
\tolerance=2000
\emergencystretch=2.5em
\hfuzz=1pt

% Float placement parameters (prevents deferred figures from queuing up at chapter ends)
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.80}
\renewcommand{\textfraction}{0.15}
\renewcommand{\floatpagefraction}{0.70}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}

% Graphics & Colors
\RequirePackage{graphicx}
\RequirePackage{rotating}
\RequirePackage{xcolor}
\graphicspath{{figures/}{../figures/}}

% Color definitions
\definecolor{hstublue}{RGB}{0, 51, 102}
\definecolor{primaryblue}{RGB}{24, 76, 120}
\definecolor{darkblue}{RGB}{12, 44, 86}
\definecolor{digiconpurple}{RGB}{96, 25, 209}
\definecolor{accentred}{RGB}{178, 24, 43}
\definecolor{accentgreen}{RGB}{27, 120, 55}
\definecolor{codebg}{RGB}{248, 249, 250}
\definecolor{grayborder}{RGB}{220, 224, 230}
\definecolor{lightgraybg}{RGB}{245, 247, 250}

% Hyperlinks & URLs
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=darkblue,
    citecolor=primaryblue,
    urlcolor=accentred,
    bookmarksnumbered=true,
    pdfstartview={FitH}
}
\RequirePackage{xurl}
\RequirePackage[htt]{hyphenat}

% Allow line breaks after underscores in normal text and \texttt (math-safe)
\DeclareRobustCommand{\_}{\ifmmode\mbox{\textunderscore}\else\textunderscore\allowbreak\fi}

% Tables & Formatting
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small,labelfont=bf,margin=10pt}
\setlength{\tabcolsep}{6pt}

% Section Numbering Depth (up to subsubsection)
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

% Headings Formatting (HSTU Institutional Specification)
\RequirePackage{titlesec}

% Chapter Title: 16pt, Bold, Flush Left, Title Case
\titleformat{\chapter}[display]
  {\normalfont\fontsize{16pt}{20pt}\bfseries\raggedright\color{darkblue}}
  {\chaptertitlename\ \thechapter}
  {6pt}
  {\fontsize{16pt}{20pt}\bfseries}

\titleformat{name=\chapter,numberless}[block]
  {\normalfont\fontsize{16pt}{20pt}\bfseries\raggedright\color{darkblue}}
  {}
  {0pt}
  {\fontsize{16pt}{20pt}\bfseries}

\titlespacing*{\chapter}{0pt}{12pt}{18pt}
\titlespacing*{name=\chapter,numberless}{0pt}{12pt}{18pt}

% Heading 1 (Section): 14pt, Bold, Flush left
\titleformat{\section}
  {\normalfont\fontsize{14pt}{18pt}\bfseries\color{primaryblue}}
  {\thesection}
  {1em}
  {}
\titlespacing*{\section}{0pt}{16pt}{8pt}

% Heading 2 (Sub-heading): 12pt, Bold, Flush left
\titleformat{\subsection}
  {\normalfont\fontsize{12pt}{15pt}\bfseries\color{darkblue}}
  {\thesubsection}
  {1em}
  {}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

% Heading 3 (Sub-sub-heading): 12pt, Italic, Flush left
\titleformat{\subsubsection}
  {\normalfont\fontsize{12pt}{15pt}\itshape\color{darkblue}}
  {\thesubsubsection}
  {1em}
  {}
\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}

% Code listings & JavaScript / TypeScript syntax highlighting
\RequirePackage{listings}
\lstdefinelanguage{JavaScript}{
  keywords={break, case, catch, class, const, continue, debugger, default, delete, do, else, export, extends, finally, for, function, if, import, in, instanceof, let, new, return, super, switch, this, throw, try, typeof, var, void, while, with, yield, async, await, of},
  keywordstyle=\color{primaryblue}\bfseries,
  ndkeywords={boolean, number, string, undefined, null, any, Promise, Observable},
  ndkeywordstyle=\color{digiconpurple}\bfseries,
  identifierstyle=\color{black},
  sensitive=true,
  comment=[l]{//},
  morecomment=[s]{/*}{*/},
  commentstyle=\color{accentgreen}\itshape,
  stringstyle=\color{accentred},
  morestring=[b]',
  morestring=[b]",
  morestring=[b]`
}

\lstset{
    language=JavaScript,
    backgroundcolor=\color{codebg},
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    breakatwhitespace=false,
    frame=single,
    rulecolor=\color{grayborder},
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    numbersep=8pt,
    showstringspaces=false,
    tabsize=2,
    captionpos=b,
    escapeinside={\%*}{*)}
}

% Headers and Footers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[LO]{\nouppercase{\rightmark}}
\fancyhead[RE]{\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\setlength{\headheight}{15pt}

% Bibliography styling
\RequirePackage[numbers,sort&compress]{natbib}
\bibliographystyle{IEEEtran}

\endinput
